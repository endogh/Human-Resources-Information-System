# Copy file ini ke `.env` lalu isi sesuai kebutuhan. Docker compose otomatis
# membaca `.env` di repo root. Tanpa `.env`, semua nilai default di
# docker-compose.yml tetap berlaku.

# --- Frontend (Django) ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- HRIS backend API gateway ---
HRIS_API_BASE_URL=http://localhost:8080
HRIS_API_TIMEOUT=30
# Admin page size for paginated lists (Elastic)
HRIS_PAGE_SIZE_ADMIN=5
# Personal page size for "my requests"
HRIS_PAGE_SIZE_PERSONAL=10

# --- Backend (opsional, ada default di docker-compose.yml) ---
POSTGRES_USER=hris
POSTGRES_PASSWORD=hris
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest